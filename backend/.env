# =================================================================
# VOX Backend - Environment Configuration
# =================================================================
# Copy this file to .env and update with your actual credentials

# Required: OpenAI API Key for AI functionality
OPENAI_API_KEY=your-openai-api-key-here

# Required: Voyage AI API Key for embeddings
VOYAGE_API_KEY=your-voyage-api-key-here

# Protobuf Configuration (keep this as-is)
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_data

# Supabase Configuration (optional - mock service will be used if not configured)
SUPABASE_URL=''
SUPABASE_SERVICE_KEY=''

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info
WORKERS=1
KEEP_ALIVE=30
LIMIT_CONCURRENCY=1000
LIMIT_MAX_REQUESTS=10000
GRACEFUL_SHUTDOWN=30

# Optional: ZenRows API Key for web scraping
ZENROWS_API_KEY=

# Optional: Enable debug logs
DEBUG_LOGS=true
LOG_REQUEST_BODY=true
