# =================================================================
# VOX CRON AI - SECURE AUTOPILOT CONFIGURATION
# =================================================================
# Copy this file to .env and update with your actual values
# NEVER commit your .env file to version control!

# =================================================================
# DATABASE CONFIGURATION - SUPABASE
# =================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here
SUPABASE_DEFAULT_BUCKET=voxflow-bucket

# Alternative: Direct PostgreSQL connection (if not using Supabase client)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# =================================================================
# GOHIGHLEVEL (GHL) CONFIGURATION
# =================================================================
GHL_API_URL=https://services.leadconnectorhq.com
GHL_ACCESS_TOKEN=your-ghl-access-token-here  # Global fallback token (optional)
GHL_REFRESH_TOKEN=your-ghl-refresh-token-here  # Global fallback refresh token (optional)
GHL_API_VERSION=2021-04-15
GHL_CLIENT_ID=your-ghl-oauth-client-id-here  # OAuth app credentials for token refresh
GHL_CLIENT_SECRET=your-ghl-oauth-client-secret-here

# =================================================================
# AI BACKEND CONFIGURATION
# =================================================================
AI_BACKEND_URL=https://your-ai-backend.com/api
AI_BACKEND_API_KEY=your-ai-backend-api-key-here  # Global fallback API key
AI_BACKEND_AUTH_TYPE=x-api-key  # Authentication type: 'x-api-key' or 'bearer'

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
# Generate secure random keys for production:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

# Secret key for API security (REQUIRED in production)
API_SECRET_KEY=development-secret-change-in-production

# API Authentication (recommended for production)
ENABLE_API_AUTH=false
API_ACCESS_TOKEN=your-secure-api-token-here

# Webhook Security (recommended if using webhooks)
ENABLE_WEBHOOK_AUTH=false  
WEBHOOK_SECRET=your-webhook-secret-here

# CORS Configuration (restrict origins in production)
ALLOWED_ORIGINS=*  # Use specific domains in production: https://yourapp.com,https://admin.yourapp.com

# Request Size Limits (bytes)
MAX_REQUEST_SIZE=1048576  # 1MB default

# =================================================================
# RATE LIMITING CONFIGURATION
# =================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100       # Requests per window
RATE_LIMIT_WINDOW=60          # Window in seconds
RATE_LIMIT_PER_IP=20          # Requests per IP per window

# =================================================================
# APPLICATION CONFIGURATION
# =================================================================
APP_ENV=development  # development, staging, production
LOG_LEVEL=INFO       # DEBUG, INFO, WARNING, ERROR, CRITICAL
HOST=0.0.0.0
PORT=8000
WORKERS=1            # Number of worker processes (production: CPU cores)

# =================================================================
# SSL/TLS CONFIGURATION (Production Only)
# =================================================================
FORCE_HTTPS=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# =================================================================
# CRON JOB CONFIGURATION
# =================================================================
CRON_INTERVAL_SECONDS=30      # How often to check for new messages
MAX_CONCURRENT_RESPONSES=10   # Max responses to process at once

# =================================================================
# DATABASE POOL CONFIGURATION
# =================================================================
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=60

# =================================================================
# REDIS CONFIGURATION (Optional - for caching and rate limiting)
# =================================================================
# Local Redis
# REDIS_URL=redis://localhost:6379

# Redis Cloud/Cluster
# REDIS_URL=redis://username:password@host:port/db

# =================================================================
# MONITORING & OBSERVABILITY (Optional)
# =================================================================
ENABLE_METRICS=true

# Sentry for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# =================================================================
# DATA PRIVACY & COMPLIANCE
# =================================================================
LOG_SENSITIVE_DATA=false      # Never enable in production
DATA_RETENTION_DAYS=90        # How long to keep response history
ANONYMIZE_LOGS=true           # Remove PII from logs

# =================================================================
# PRODUCTION DEPLOYMENT SETTINGS
# =================================================================
# These settings should be used in production environments

# Example Production Configuration:
# APP_ENV=production
# LOG_LEVEL=INFO
# WORKERS=4
# FORCE_HTTPS=true
# ENABLE_API_AUTH=true
# ENABLE_WEBHOOK_AUTH=true
# ALLOWED_ORIGINS=https://yourapp.com,https://admin.yourapp.com
# API_SECRET_KEY=your-super-secure-random-secret-key
# API_ACCESS_TOKEN=your-secure-api-token
# WEBHOOK_SECRET=your-webhook-secret
# RATE_LIMIT_REQUESTS=200
# RATE_LIMIT_PER_IP=50
# REDIS_URL=redis://your-redis-cluster
# SENTRY_DSN=https://your-sentry-dsn

# =================================================================
# DOCKER DEPLOYMENT (Optional)
# =================================================================
# If deploying with Docker, these can override the defaults:
# DOCKERFILE_PORT=8000
# CONTAINER_WORKERS=4
# CONTAINER_HOST=0.0.0.0

# =================================================================
# BACKUP AND DISASTER RECOVERY (Optional)
# =================================================================
# DB_BACKUP_URL=postgresql://backup-user:password@backup-host:port/dbname
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30

# =================================================================
# LOAD BALANCER / REVERSE PROXY SETTINGS
# =================================================================
# PROXY_HEADERS=true         # If behind nginx/cloudflare
# TRUSTED_HOSTS=your-domain.com,api.your-domain.com 